{
  "name": "spoofer-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SPOOFER backend - GNSS IF file generation + bladeRF transmit (migrated from bladeRF GNSS Studio)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tools": "node dist/cli.js",
    "tools:dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "~5.4.5"
  }
}